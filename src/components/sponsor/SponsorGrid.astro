---
import type { Sponsor } from "@lib/content/schema";

interface Props {
  sponsors: Sponsor[];
}

const { sponsors } = Astro.props;
const tierLabels: Record<string, string> = {
  gold: "Gold Sponsor",
  silver: "Silver Sponsor",
  bronze: "Bronze Sponsor",
  partner: "Partner"
};
---

<div class="sponsor-grid">
  {sponsors.map((sponsor) => (
    <article class={`sponsor-card ${sponsor.tier}`} data-reveal>
      {sponsor.url ? (
        <a href={sponsor.url} target="_blank" rel="noreferrer">
          <div class="sponsor-logo">
            {sponsor.logo ? (
              <img src={sponsor.logo} alt={`${sponsor.name} ロゴ`} width="360" height="160" loading="lazy" decoding="async" />
            ) : sponsor.name}
          </div>
          <p class="sponsor-tier">{tierLabels[sponsor.tier]}</p>
          <h3>{sponsor.name}</h3>
          {sponsor.message && <p>{sponsor.message}</p>}
        </a>
      ) : (
        <>
          <div class="sponsor-logo">
            {sponsor.logo ? (
              <img src={sponsor.logo} alt={`${sponsor.name} ロゴ`} width="360" height="160" loading="lazy" decoding="async" />
            ) : sponsor.name}
          </div>
          <p class="sponsor-tier">{tierLabels[sponsor.tier]}</p>
          <h3>{sponsor.name}</h3>
          {sponsor.message && <p>{sponsor.message}</p>}
        </>
      )}
    </article>
  ))}
</div>
