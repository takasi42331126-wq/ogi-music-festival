---
import type { Sponsor } from "@lib/content/schema";

interface Props {
  sponsors: Sponsor[];
}

type PartnerRankId = "premium" | "gold" | "silver" | "bronze";

const { sponsors } = Astro.props;

const partnerRanks: Array<{
  id: PartnerRankId;
  label: string;
  subtitle: string;
  amount: number;
}> = [
  { id: "premium", label: "PREMIUM PARTNER", subtitle: "プレミアムパートナー", amount: 300000 },
  { id: "gold", label: "GOLD PARTNER", subtitle: "ゴールドパートナー", amount: 200000 },
  { id: "silver", label: "SILVER PARTNER", subtitle: "シルバーパートナー", amount: 100000 },
  { id: "bronze", label: "BRONZE PARTNER", subtitle: "ブロンズパートナー", amount: 50000 }
];

const getPartnerRankId = (amount?: number): PartnerRankId | null => {
  const rank = partnerRanks.find((item) => item.amount === amount);
  return rank?.id ?? null;
};

const specialSponsors = sponsors.filter((sponsor) => sponsor.category === "特別協賛");
const nominalSponsors = sponsors.filter((sponsor) => sponsor.category === "名義協賛");
const nominalSupporters = sponsors.filter((sponsor) => sponsor.category === "名義後援");
const rankedSponsors = partnerRanks.map((rank) => ({
  ...rank,
  items: specialSponsors.filter((sponsor) => getPartnerRankId(sponsor.amount) === rank.id)
}));

const nominalGroups = [
  {
    id: "nominal-sponsor",
    title: "名義協賛",
    items: nominalSponsors
  },
  {
    id: "nominal-support",
    title: "名義後援",
    items: nominalSupporters
  }
].filter((group) => group.items.length > 0);
---

<div class="sponsor-groups">
  <section class="sponsor-group sponsor-section-block" aria-labelledby="sponsor-special-sponsor">
    <h3 id="sponsor-special-sponsor" class="sponsor-category-title">特別協賛</h3>

    <div class="partner-rank-stack">
      {rankedSponsors.map((rank) => (
        <section class={`partner-rank partner-rank-${rank.id}`} aria-labelledby={`partner-rank-${rank.id}`}>
          <div class="partner-rank-header">
            <h4 id={`partner-rank-${rank.id}`} class="partner-rank-title">
              <span class="partner-rank-title-main">{rank.label}</span>
              <span class="partner-rank-title-sub">{rank.subtitle}</span>
            </h4>
          </div>

          {rank.items.length > 0 ? (
            <div class={`sponsor-grid partner-grid partner-grid-${rank.id}`}>
              {rank.items.map((sponsor) => (
                <article class={`sponsor-card sponsor-card-${rank.id}`} data-reveal>
                  {sponsor.url ? (
                    <a href={sponsor.url} target="_blank" rel="noreferrer">
                      {sponsor.logo ? (
                        <>
                          <div class="sponsor-logo">
                          <img src={sponsor.logo} alt={`${sponsor.name} ロゴ`} width="360" height="160" loading="lazy" decoding="async" />
                          </div>
                          <p class="sponsor-category">{rank.label}</p>
                          <h5>{sponsor.name}</h5>
                        </>
                      ) : (
                        <>
                          <h5 class="sponsor-logo sponsor-logo-text">{sponsor.name}</h5>
                          <p class="sponsor-category">{rank.label}</p>
                        </>
                      )}
                      {sponsor.message && <p>{sponsor.message}</p>}
                    </a>
                  ) : (
                    <>
                      {sponsor.logo ? (
                        <>
                          <div class="sponsor-logo">
                          <img src={sponsor.logo} alt={`${sponsor.name} ロゴ`} width="360" height="160" loading="lazy" decoding="async" />
                          </div>
                          <p class="sponsor-category">{rank.label}</p>
                          <h5>{sponsor.name}</h5>
                        </>
                      ) : (
                        <>
                          <h5 class="sponsor-logo sponsor-logo-text">{sponsor.name}</h5>
                          <p class="sponsor-category">{rank.label}</p>
                        </>
                      )}
                      {sponsor.message && <p>{sponsor.message}</p>}
                    </>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <p class="sponsor-empty" data-reveal>掲載企業は決定次第お知らせします。</p>
          )}
        </section>
      ))}
    </div>
  </section>

  {nominalGroups.map((group) => (
    <section class="sponsor-group sponsor-section-block sponsor-nominal-group" aria-labelledby={`sponsor-${group.id}`}>
      <h3 id={`sponsor-${group.id}`} class="sponsor-category-title">{group.title}</h3>
      <div class="sponsor-grid support-grid nominal-grid">
        {group.items.map((sponsor) => (
          <article class="sponsor-card support sponsor-card-nominal" data-reveal>
            {sponsor.url ? (
              <a href={sponsor.url} target="_blank" rel="noreferrer">
                <h4>{sponsor.name}</h4>
                {sponsor.message && <p>{sponsor.message}</p>}
              </a>
            ) : (
              <>
                <h4>{sponsor.name}</h4>
                {sponsor.message && <p>{sponsor.message}</p>}
              </>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}
</div>
