---
interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  note?: string;
}

const { eyebrow, title, lead, note } = Astro.props;
---

<section class="page-hero">
  <div class="section-inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{lead}</p>
    {note && <p>{note}</p>}
  </div>
</section>
