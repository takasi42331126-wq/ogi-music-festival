---
import type { Event } from "@lib/content/schema";

interface Props {
  event: Event;
}

const { event } = Astro.props;
const fallbackMobileSrc = event.heroImage.includes("main.webp")
  ? event.heroImage.replace("main.webp", "main-mobile.webp")
  : event.heroImage;
const fallbackSlide = {
  src: event.heroImage,
  mobileSrc: fallbackMobileSrc,
  alt: `${event.title} メインビジュアル`
};
const heroSlides = event.heroImages?.length ? event.heroImages : [fallbackSlide];
---

<section class="hero" data-reveal data-hero-carousel>
  <div class="hero-media" aria-hidden="true">
    {heroSlides.map((slide, index) => (
      <picture class={`hero-slide${index === 0 ? " is-active" : ""}`} data-hero-slide>
        <source srcset={slide.mobileSrc} media="(max-width: 680px)" />
        <img
          src={slide.src}
          alt=""
          width="1600"
          height="900"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 ? "high" : "low"}
        />
      </picture>
    ))}
  </div>
  <div class="hero-screen" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-content">
      <p class="hero-kicker">Ogi Amateur Music Festival DX {event.year}</p>
      <h1>{event.title}</h1>
      <p class="hero-copy">{event.catchcopy}</p>
      <p class="hero-lead">{event.lead}</p>
      <div class="button-row">
        <a class="button button-primary" href={event.cta.primaryHref}>{event.cta.primaryLabel}</a>
        <a class="button button-secondary" href={event.cta.secondaryHref}>{event.cta.secondaryLabel}</a>
        <a class="button button-ghost" href="/timetable/">タイムテーブル</a>
      </div>
      <div class="hero-meta" aria-label="開催概要">
        <div class="hero-meta-item">
          <span class="hero-meta-label">開催日</span>
          <span class="hero-meta-value">{event.dateText}</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">会場</span>
          <span class="hero-meta-value">{event.venueName}</span>
        </div>
      </div>
    </div>
  </div>
  <a class="hero-scroll" href="#festival-info" aria-label="次のセクションへ移動">Scroll</a>
  <script>
    (() => {
      document.querySelectorAll("[data-hero-carousel]").forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll("[data-hero-slide]"));
        if (slides.length <= 1) {
          return;
        }

        let currentIndex = 0;
        window.setInterval(() => {
          slides[currentIndex]?.classList.remove("is-active");
          currentIndex = (currentIndex + 1) % slides.length;
          slides[currentIndex]?.classList.add("is-active");
        }, 3000);
      });
    })();
  </script>
</section>
