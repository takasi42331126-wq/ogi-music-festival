---
import type { TimetableItem } from "@lib/content/schema";
import { getArtistById } from "@lib/content/repository";

interface Props {
  items: TimetableItem[];
  stages: string[];
}

const { items, stages } = Astro.props;
const grouped = stages.map((stage) => ({
  stage,
  items: items
    .filter((item) => item.stage === stage)
    .sort((a, b) =>
      `${a.date}${a.startTime}${String(a.order ?? 0).padStart(3, "0")}`.localeCompare(
        `${b.date}${b.startTime}${String(b.order ?? 0).padStart(3, "0")}`
      )
    )
}));
---

<div class="timetable">
  {grouped.map(({ stage, items }) => (
    <section class="stage-block" aria-labelledby={`${stage}-heading`} data-reveal>
      <h3 id={`${stage}-heading`} class="stage-title">{stage}</h3>
      <ul class="time-list">
        {items.map((item) => {
          const artist = item.artistId ? getArtistById(item.artistId) : undefined;
          const meta = Array.from(
            new Set([artist?.role, item.category, item.progress, item.note].filter((label): label is string => Boolean(label)))
          );
          return (
            <li class="time-item">
              <div class="time-range">
                <span>{item.startTime} - {item.endTime}</span>
                {typeof item.durationMinutes === "number" && <span class="time-duration">{item.durationMinutes}分</span>}
              </div>
              <div>
                <span class="time-title">{item.title}</span>
                {meta.length > 0 && (
                  <div class="time-meta">
                    {meta.map((label) => <span class="time-note">{label}</span>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</div>
