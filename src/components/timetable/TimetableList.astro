---
import type { TimetableItem } from "@lib/content/schema";
import { getArtistById } from "@lib/content/repository";

interface Props {
  items: TimetableItem[];
  stages: string[];
  collapseFromTime?: string;
}

const { items, stages, collapseFromTime } = Astro.props;
const grouped = stages.map((stage) => ({
  stage,
  items: items
    .filter((item) => item.stage === stage)
    .sort((a, b) =>
      `${a.date}${a.startTime}${String(a.order ?? 0).padStart(3, "0")}`.localeCompare(
        `${b.date}${b.startTime}${String(b.order ?? 0).padStart(3, "0")}`
      )
    )
}));

const getMeta = (item: TimetableItem) => {
  const artist = item.artistId ? getArtistById(item.artistId) : undefined;

  return Array.from(
    new Set([artist?.role, item.category, item.progress, item.note].filter((label): label is string => Boolean(label)))
  );
};

const shouldCollapse = (item: TimetableItem) =>
  typeof collapseFromTime === "string" && item.startTime >= collapseFromTime;
---

<div class="timetable">
  {grouped.map(({ stage, items }) => (
    <section class="stage-block" aria-labelledby={`${stage}-heading`} data-reveal>
      <h3 id={`${stage}-heading`} class="stage-title">{stage}</h3>
      <ul class="time-list">
        {items.filter((item) => !shouldCollapse(item)).map((item) => {
          const meta = getMeta(item);
          return (
            <li class="time-item">
              <div class="time-range">
                <span>{item.startTime} - {item.endTime}</span>
                {typeof item.durationMinutes === "number" && <span class="time-duration">{item.durationMinutes}分</span>}
              </div>
              <div>
                <span class="time-title">{item.title}</span>
                {meta.length > 0 && (
                  <div class="time-meta">
                    {meta.map((label) => <span class="time-note">{label}</span>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>

      {collapseFromTime && items.some(shouldCollapse) && (
        <details class="timetable-more">
          <summary class="timetable-more-summary">
            <span class="timetable-more-text timetable-more-text-closed">続きを見る</span>
            <span class="timetable-more-text timetable-more-text-open">閉じる</span>
            <span class="timetable-more-subtext">{collapseFromTime}以降のスケジュール</span>
          </summary>

          <ul class="time-list time-list-collapsed">
            {items.filter(shouldCollapse).map((item) => {
              const meta = getMeta(item);
              return (
                <li class="time-item">
                  <div class="time-range">
                    <span>{item.startTime} - {item.endTime}</span>
                    {typeof item.durationMinutes === "number" && <span class="time-duration">{item.durationMinutes}分</span>}
                  </div>
                  <div>
                    <span class="time-title">{item.title}</span>
                    {meta.length > 0 && (
                      <div class="time-meta">
                        {meta.map((label) => <span class="time-note">{label}</span>)}
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </details>
      )}
    </section>
  ))}
</div>
