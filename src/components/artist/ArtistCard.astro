---
import type { Artist } from "@lib/content/schema";

interface Props {
  artist: Artist;
}

const { artist } = Astro.props;
const profileCollapseThreshold = 70;
const hasProfile = artist.profile.trim().length > 0;
const isLongProfile = hasProfile && (artist.profile.length > profileCollapseThreshold || artist.profile.includes("\n"));
const profileId = `${artist.id}-profile`;
const hasImage = artist.image.trim().length > 0;
const imageFit = artist.imageFit ?? "cover";
const imageLabel = imageFit === "contain" ? "ロゴ" : "写真";
---

<article class:list={["artist-card", { "artist-card-no-image": !hasImage }]} data-reveal>
  {hasImage ? (
    <figure class:list={["artist-visual", `artist-visual-${imageFit}`]}>
      <img
        src={artist.image}
        alt={`${artist.name}の${imageLabel}`}
        width="720"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <figcaption>{artist.stage}</figcaption>
    </figure>
  ) : (
    <figure class="artist-visual artist-visual-placeholder">
      <span class="artist-visual-name">{artist.name}</span>
      <figcaption>{artist.stage}</figcaption>
    </figure>
  )}
  <div class="artist-card-body">
    <div class="artist-meta">{artist.role}</div>
    <h3>{artist.name}</h3>
    {hasProfile && (
      <p id={profileId} class={`artist-profile${isLongProfile ? " is-collapsible" : ""}`} data-artist-profile>{artist.profile}</p>
    )}
    {isLongProfile && (
      <button
        class="artist-profile-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={profileId}
        data-profile-toggle
      >
        続きを読む
      </button>
    )}
  </div>
</article>

<script>
  document.querySelectorAll("[data-profile-toggle]").forEach((button) => {
    const targetId = button.getAttribute("aria-controls");
    const profile = targetId ? document.getElementById(targetId) : null;

    if (!profile) {
      return;
    }

    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!isExpanded));
      profile.classList.toggle("is-expanded", !isExpanded);
      button.textContent = isExpanded ? "続きを読む" : "閉じる";
    });
  });
</script>
