---
import type { Venue } from "@lib/content/schema";

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const mapAlt = venue.mapImageAlt ?? `${venue.name} 会場マップ`;
---

{
  venue.mapImage ? (
    <figure class="venue-overview-map">
      <img
        src={venue.mapImage}
        alt={mapAlt}
        width={venue.mapImageWidth}
        height={venue.mapImageHeight}
        loading="lazy"
        decoding="async"
      />
    </figure>
  ) : (
    <div class="map-canvas" aria-label="会場マップの簡易図">
      <div class="map-zone map-zone-main">Main Stage</div>
      <div class="map-zone map-zone-garden">Garden Stage</div>
      <div class="map-zone map-zone-food">Food Area</div>
      <div class="map-zone map-zone-info">Information</div>
    </div>
  )
}
