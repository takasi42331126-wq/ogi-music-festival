---
import { artists, config, event, gallery, news, sponsors, timetable } from "@lib/content/repository";

const panels = [
  {
    id: "event",
    label: "基本情報",
    title: "開催情報",
    fields: [
      { label: "タイトル", value: event.title },
      { label: "開催日", value: event.dateText },
      { label: "会場", value: event.venueName },
      { label: "キャッチコピー", value: event.catchcopy }
    ],
    json: event
  },
  {
    id: "artists",
    label: "出演者",
    title: "出演者管理",
    fields: artists.map((artist) => ({ label: artist.name, value: artist.genre })),
    json: artists
  },
  {
    id: "timetable",
    label: "タイムテーブル",
    title: "タイムテーブル管理",
    fields: timetable.map((item) => ({ label: `${item.startTime} - ${item.endTime}`, value: item.title })),
    json: timetable
  },
  {
    id: "sponsors",
    label: "協賛企業",
    title: "協賛企業管理",
    fields: sponsors.map((sponsor) => ({ label: sponsor.name, value: sponsor.tier })),
    json: sponsors
  },
  {
    id: "news",
    label: "お知らせ",
    title: "お知らせ管理",
    fields: news.map((item) => ({ label: item.title, value: item.category })),
    json: news
  },
  {
    id: "gallery",
    label: "ギャラリー",
    title: "ギャラリー管理",
    fields: gallery.map((item) => ({ label: item.title, value: item.category })),
    json: gallery
  },
  {
    id: "settings",
    label: "設定",
    title: "公開設定",
    fields: [
      { label: "公開URL", value: config.site.baseUrl },
      { label: "本番ブランチ", value: config.deployment.productionBranch },
      { label: "管理画面", value: config.features.adminDemo ? "デモ表示" : "非表示" }
    ],
    json: config
  }
];
---

<div class="admin-shell" data-admin-demo>
  <aside class="admin-sidebar" aria-label="管理メニュー">
    {panels.map((panel, index) => (
      <button
        class="admin-tab"
        type="button"
        data-admin-tab={panel.id}
        aria-selected={index === 0 ? "true" : "false"}
      >
        {panel.label}
      </button>
    ))}
  </aside>

  <div>
    {panels.map((panel, index) => (
      <section class="admin-panel" data-admin-panel={panel.id} data-active={index === 0 ? "true" : "false"}>
        <div class="section-header">
          <p class="eyebrow">Demo Admin</p>
          <h2>{panel.title}</h2>
          <p>年度更新に必要な情報を、画面上で確認しながら編集する想定のデモです。</p>
        </div>

        <div class="admin-grid">
          {panel.fields.map((field) => (
            <article class="admin-card">
              <p class="artist-meta">{field.label}</p>
              <h3>{field.value}</h3>
              <p>公開前に内容を確認するための項目です。</p>
            </article>
          ))}
        </div>

        <div class="contact-panel" style="margin-top: 22px;">
          <div class="form-grid">
            <div class="form-field">
              <label for={`${panel.id}-title`}>項目名</label>
              <input id={`${panel.id}-title`} value={panel.fields[0]?.label ?? ""} />
            </div>
            <div class="form-field">
              <label for={`${panel.id}-body`}>内容</label>
              <textarea id={`${panel.id}-body`}>{panel.fields[0]?.value ?? ""}</textarea>
            </div>
          </div>
          <div class="admin-actions">
            <button class="button button-primary" type="button">プレビュー</button>
            <button class="button button-outline" type="button">下書き保存</button>
            <span class="status-pill">デモ</span>
          </div>
        </div>

        <pre class="json-preview"><code>{JSON.stringify(panel.json, null, 2)}</code></pre>
      </section>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector("[data-admin-demo]");
  const tabs = root?.querySelectorAll("[data-admin-tab]");
  const panels = root?.querySelectorAll("[data-admin-panel]");

  tabs?.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.getAttribute("data-admin-tab");
      tabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
      panels?.forEach((panel) => {
        panel.setAttribute("data-active", String(panel.getAttribute("data-admin-panel") === target));
      });
    });
  });
</script>
