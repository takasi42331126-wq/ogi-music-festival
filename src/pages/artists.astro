---
import ArtistCard from "@components/artist/ArtistCard.astro";
import BaseLayout from "@components/layout/BaseLayout.astro";
import PageHero from "@components/layout/PageHero.astro";
import SectionHeader from "@components/layout/SectionHeader.astro";
import { artists } from "@lib/content/repository";

const artistSections = [
  {
    id: "hosts-guests",
    eyebrow: "MC / Guest",
    title: "司会・ゲスト",
    lead: "小城の一日を明るく彩る司会・ゲストをご紹介します。",
    items: artists.filter((artist) => ["司会", "アシスタント", "ゲスト"].includes(artist.role))
  },
  {
    id: "dance",
    eyebrow: "Dance",
    title: "ダンス出演者",
    lead: "メインステージを華やかに盛り上げるダンスチームです。",
    items: artists.filter((artist) => artist.role === "ダンス")
  },
  {
    id: "band",
    eyebrow: "Band",
    title: "バンド出演者",
    lead: "音楽祭のステージを彩るバンド・音楽出演者です。",
    items: artists.filter((artist) => artist.role === "バンド")
  }
].filter((section) => section.items.length > 0);
---

<BaseLayout title="出演者紹介" description="第35回おぎアマチュア音楽祭DX2026の出演者情報を紹介します。">
  <PageHero
    eyebrow="Artists"
    title="出演者紹介"
    lead="司会、アシスタント、ゲストが小城の一日を明るく彩ります。"
  />

  <section class="section">
    <div class="section-inner">
      <div class="artist-section-stack">
        {artistSections.map((section) => (
          <section class="artist-section">
            <SectionHeader
              eyebrow={section.eyebrow}
              title={section.title}
              lead={section.lead}
            />
            <div class="artist-grid">
              {section.items.map((artist) => <ArtistCard artist={artist} />)}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
