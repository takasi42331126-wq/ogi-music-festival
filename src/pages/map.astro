---
import BaseLayout from "@components/layout/BaseLayout.astro";
import PageHero from "@components/layout/PageHero.astro";
import SectionHeader from "@components/layout/SectionHeader.astro";
import VenueOverviewMap from "@components/venue/VenueOverviewMap.astro";
import VenueEventMap from "@components/venue/VenueEventMap.astro";
import { venue } from "@lib/content/repository";
---

<BaseLayout title="会場マップ" description="第35回おぎアマチュア音楽祭DX2026の会場マップを掲載しています。">
  <PageHero
    eyebrow="Map"
    title="会場マップ"
    lead="ステージ、飲食エリア、案内所など、当日必要な場所を確認できます。"
  />

  <section class="section">
    <div class="section-inner">
      <div>
        <SectionHeader
          eyebrow="Venue"
          title={venue.name}
          lead="ステージ、飲食エリア、案内所の位置を確認して、当日をゆっくり楽しめるように準備できます。"
        />
        <VenueOverviewMap venue={venue} />
      </div>
    </div>
  </section>

  <VenueEventMap maps={venue.eventMaps} />
</BaseLayout>
