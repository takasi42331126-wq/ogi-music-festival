---
import BaseLayout from "@components/layout/BaseLayout.astro";
import { CHECKIN_VENUES } from "../data/checkinVenues.js";
---

<BaseLayout
  title="来場者チェックイン"
  description="第35回おぎアマチュア音楽祭DX2026の来場者チェックインページです。"
  noindex
>
  <section class="checkin-page section">
    <div class="section-inner checkin-shell">
      <div class="checkin-hero">
        <p class="eyebrow">Check-in</p>
        <h1>おぎアマチュア音楽祭DX2026</h1>
        <p class="checkin-venue" data-checkin-venue hidden></p>
        <p>ご来場ありがとうございます。人数を選んでチェックインすると、その場で抽選結果が表示されます。</p>
      </div>

      <div class="checkin-card" data-checkin-root>
        <div class="checkin-status" data-checkin-status>読み込み中です...</div>

        <form class="checkin-form" data-checkin-form hidden>
          <div>
            <p class="checkin-question">あなたを含めて何名で来場しましたか？</p>
            <div class="checkin-choice-grid" role="radiogroup" aria-label="来場人数">
              {[1, 2, 3, 4].map((count) => (
                <label class="checkin-choice">
                  <input type="radio" name="visitor-count" value={count} required />
                  <span>{count}名</span>
                </label>
              ))}
              <label class="checkin-choice">
                <input type="radio" name="visitor-count" value="custom" required />
                <span>5名以上</span>
              </label>
            </div>
          </div>

          <div class="checkin-custom-count" data-custom-count hidden>
            <label for="visitor-count-custom">人数を入力してください</label>
            <input id="visitor-count-custom" name="visitor-count-custom" type="number" min="5" max="99" inputmode="numeric" value="5" />
          </div>

          <button class="button button-primary checkin-submit" type="submit" data-checkin-submit>
            チェックインして抽選する
          </button>
        </form>

        <div class="checkin-result" data-checkin-result hidden></div>
      </div>
    </div>
  </section>

  <script define:vars={{ checkinVenues: CHECKIN_VENUES }}>
    const root = document.querySelector("[data-checkin-root]");
    const venueEl = document.querySelector("[data-checkin-venue]");
    const statusEl = root?.querySelector("[data-checkin-status]");
    const form = root?.querySelector("[data-checkin-form]");
    const customCount = root?.querySelector("[data-custom-count]");
    const submitButton = root?.querySelector("[data-checkin-submit]");
    const resultEl = root?.querySelector("[data-checkin-result]");
    const params = new URLSearchParams(window.location.search);
    const mode = params.get("mode") === "test" ? "test" : "live";
    const venues = new Map(checkinVenues.map((venue) => [venue.id, venue]));
    const rawVenueId = params.get("venue") || params.get("venue_id") || "";
    const venue = venues.get(rawVenueId);
    const venueId = venue?.id || "";
    const visitorStorageKey = `ogi-dx2026-visitor:${mode}`;
    const storageKey = venueId ? `ogi-dx2026-checkin:${mode}:${venueId}` : "";

    const escapeHtml = (value) =>
      String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");

    const setStatus = (message, isError = false) => {
      if (!(statusEl instanceof HTMLElement)) {
        return;
      }
      statusEl.textContent = message;
      statusEl.dataset.error = String(isError);
      statusEl.hidden = false;
    };

    const showForm = () => {
      if (form instanceof HTMLFormElement) {
        form.hidden = false;
      }
      if (resultEl instanceof HTMLElement) {
        resultEl.hidden = true;
      }
      if (statusEl instanceof HTMLElement) {
        statusEl.hidden = true;
      }
    };

    const venueLabel = (venueIdValue) => venues.get(venueIdValue)?.label || venueIdValue;
    const prizePickupLocations = new Map([
      ["park", "本部テント"],
      ["yumeplat", "１F受付"],
      ["highschool", "近くのスタッフまでお声がけください。"],
      ["university", "近くのスタッフ（青色のポロシャツ）までお声がけください。"],
      ["sakuraoka", "近くのスタッフ（青色のポロシャツ）までお声がけください。"]
    ]);

    const prizePickupLocation = (venueIdValue) => prizePickupLocations.get(venueIdValue) || "近くのスタッフまでお声がけください。";

    const generateAnonymousId = () => {
      const bytes = new Uint8Array(4);
      window.crypto.getRandomValues(bytes);
      const value = Array.from(bytes, (byte) => byte.toString(36).padStart(2, "0"))
        .join("")
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "")
        .slice(0, 6);
      return `A-${value}`;
    };

    const getOrCreateAnonymousId = () => {
      const existing = window.localStorage.getItem(visitorStorageKey);
      if (existing && /^A-[A-Z0-9]{6,24}$/.test(existing)) {
        return existing;
      }
      const id = generateAnonymousId();
      window.localStorage.setItem(visitorStorageKey, id);
      return id;
    };

    const resultMarkup = (result) => {
      const isWin = result.result === "win";
      const claimed = Boolean(result.claimed_at);
      if (isWin) {
        return `
          <div class="checkin-result-hero checkin-result-win">
            <p class="eyebrow">Lottery Result</p>
            <h2 class="checkin-result-title">🎉 当選！</h2>
            ${result.prize_name ? `<p class="checkin-prize-name">景品：${escapeHtml(result.prize_name)}</p>` : ""}
          </div>
          <dl class="checkin-result-list">
            <div><dt>会場</dt><dd>${escapeHtml(venueLabel(result.venue_id))}</dd></div>
            <div><dt>受付人数</dt><dd>${Number(result.visitor_count).toLocaleString("ja-JP")}名</dd></div>
            <div><dt>受け取り場所</dt><dd>${escapeHtml(prizePickupLocation(result.venue_id))}</dd></div>
          </dl>
          <p class="checkin-staff-message ${claimed ? "is-claimed" : ""}">
            ${claimed ? "この賞品は受取済みです。" : "この画面をスタッフにお見せください。"}
          </p>
          ${claimed ? "" : '<button class="button button-primary checkin-claim" type="button" data-result-claim>受け取り済みにする</button>'}
        `;
      }

      return `
        <div class="checkin-result-hero">
          <p class="eyebrow">Lottery Result</p>
          <h2>残念！今回はハズレです</h2>
          <p>ご参加ありがとうございます！<br />引き続きお楽しみください。</p>
        </div>
        <dl class="checkin-result-list">
          <div><dt>会場</dt><dd>${escapeHtml(venueLabel(result.venue_id))}</dd></div>
          <div><dt>受付人数</dt><dd>${Number(result.visitor_count).toLocaleString("ja-JP")}名</dd></div>
        </dl>
      `;
    };

    const showResult = (result, checkedIn = false) => {
      if (!(resultEl instanceof HTMLElement)) {
        return;
      }
      if (form instanceof HTMLFormElement) {
        form.hidden = true;
      }
      if (statusEl instanceof HTMLElement) {
        statusEl.hidden = true;
      }
      resultEl.innerHTML = `
        ${checkedIn ? '<p class="checkin-already">チェックイン済みです</p>' : ""}
        ${resultMarkup(result)}
        <button class="button button-outline checkin-reload" type="button" data-result-refresh>抽選結果を再読み込み</button>
      `;
      resultEl.hidden = false;
      resultEl.querySelector("[data-result-refresh]")?.addEventListener("click", loadExistingResult);
      resultEl.querySelector("[data-result-claim]")?.addEventListener("click", async (event) => {
        const button = event.currentTarget;
        if (!(button instanceof HTMLButtonElement) || !window.confirm("景品を受け取り済みにしますか？")) {
          return;
        }

        button.disabled = true;
        button.textContent = "更新しています...";
        try {
          const data = await requestJson("/api/checkin/claim", {
            method: "POST",
            body: JSON.stringify({
              anonymousId: result.anonymous_id,
              venueId: result.venue_id,
              mode: result.mode
            })
          });
          showResult(data.result, checkedIn);
        } catch (error) {
          setStatus(error instanceof Error ? error.message : "受取状況を更新できませんでした。", true);
          button.disabled = false;
          button.textContent = "受け取り済みにする";
        }
      });
    };

    const requestJson = async (url, options = {}) => {
      const response = await fetch(url, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          ...(options.headers ?? {})
        }
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || data.ok === false) {
        throw new Error(data.error || "通信に失敗しました。");
      }
      return data;
    };

    async function loadExistingResult() {
      const anonymousId = window.localStorage.getItem(storageKey);
      if (!anonymousId) {
        showForm();
        return;
      }

      setStatus("チェックイン済み情報を確認しています...");
      try {
        const data = await requestJson(`/api/checkin/result?anonymousId=${encodeURIComponent(anonymousId)}&venue=${encodeURIComponent(venueId)}&mode=${mode}`);
        showResult(data.result, true);
      } catch (error) {
        window.localStorage.removeItem(storageKey);
        setStatus(error instanceof Error ? error.message : "結果を確認できませんでした。", true);
        showForm();
      }
    }

    const syncCustomCountInput = () => {
      const selected = form?.querySelector('input[name="visitor-count"]:checked');
      const isCustomCount = selected instanceof HTMLInputElement && selected.value === "custom";
      const customInput = form?.querySelector('input[name="visitor-count-custom"]');
      if (customCount instanceof HTMLElement) {
        customCount.hidden = !isCustomCount;
      }
      if (customInput instanceof HTMLInputElement) {
        customInput.disabled = !isCustomCount;
        if (isCustomCount && customInput.value === "") {
          customInput.value = "5";
        }
      }
    };

    form?.querySelectorAll('input[name="visitor-count"]').forEach((input) => {
      input.addEventListener("change", syncCustomCountInput);
    });
    syncCustomCountInput();

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) {
        return;
      }
      const selected = form.querySelector('input[name="visitor-count"]:checked');
      if (!(selected instanceof HTMLInputElement)) {
        setStatus("来場人数を選択してください。", true);
        return;
      }

      syncCustomCountInput();
      const isCustomCount = selected.value === "custom";
      const customInput = form.querySelector('input[name="visitor-count-custom"]');
      const visitorCount = isCustomCount && customInput instanceof HTMLInputElement
        ? Number(customInput.value)
        : Number(selected.value);
      const minVisitorCount = isCustomCount ? 5 : 1;
      const maxVisitorCount = isCustomCount ? 99 : 4;

      if (!Number.isInteger(visitorCount) || visitorCount < minVisitorCount || visitorCount > maxVisitorCount) {
        setStatus(isCustomCount ? "5名以上は5〜99名で入力してください。" : "来場人数を選択してください。", true);
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }
      setStatus("チェックインと抽選を行っています...");

      try {
        const anonymousId = getOrCreateAnonymousId();
        const data = await requestJson("/api/checkin", {
          method: "POST",
          body: JSON.stringify({ anonymousId, visitorCount, venueId, mode })
        });
        window.localStorage.setItem(storageKey, data.result.anonymous_id);
        showResult(data.result, false);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : "チェックインできませんでした。", true);
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });

    if (venue) {
      if (venueEl instanceof HTMLElement) {
        venueEl.textContent = venue.displayName;
        venueEl.hidden = false;
      }
      loadExistingResult();
    } else {
      setStatus("会場URLが正しくありません。会場のQRコードからアクセスしてください。", true);
    }
  </script>
</BaseLayout>
