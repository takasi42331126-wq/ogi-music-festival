---
import BaseLayout from "@components/layout/BaseLayout.astro";
import PageHero from "@components/layout/PageHero.astro";
import SectionHeader from "@components/layout/SectionHeader.astro";
import { aboutMessages, site } from "@lib/content/repository";
---

<BaseLayout title="音楽祭について" description={`${site.siteName}の概要と開催への想いを紹介します。`}>
  <PageHero
    eyebrow="About"
    title="音楽祭について"
    lead="35年の歴史を次の未来へつなぐ、第35回おぎアマチュア音楽祭DX2026への想いを紹介します。"
  />

  <section class="section">
    <div class="section-inner about-message-section">
      <SectionHeader
        eyebrow="Message"
        title="ご挨拶"
        lead="音楽祭を支える想いと、今年の開催に向けたメッセージです。"
      />

      <div class="about-message-list">
        {aboutMessages.map((message) => (
          <article class="about-message-card" data-reveal>
            <div class="about-message-visual">
              <img
                src={message.image}
                alt={message.imageAlt}
                width={message.imageWidth}
                height={message.imageHeight}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="about-message-body">
              <p class="about-message-role">{message.role}</p>
              <h2>{message.name}</h2>
              <div class="about-message-text">
                {message.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </div>
              {message.signature.length > 0 && (
                <div class="about-message-signature">
                  {message.signature.map((line) => <p>{line}</p>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
